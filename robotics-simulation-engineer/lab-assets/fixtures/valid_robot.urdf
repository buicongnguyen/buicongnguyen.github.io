<?xml version="1.0"?>
<robot name="audit_fixture">
  <link name="base_link">
    <visual><geometry><box size="0.4 0.3 0.15"/></geometry></visual>
    <collision><geometry><box size="0.4 0.3 0.15"/></geometry></collision>
    <inertial>
      <mass value="8.0"/>
      <!-- Solid box 0.4 x 0.3 x 0.15: ixx = m(y^2+z^2)/12, iyy = m(x^2+z^2)/12, izz = m(x^2+y^2)/12 -->
      <inertia ixx="0.075" ixy="0" ixz="0" iyy="0.12167" iyz="0" izz="0.16667"/>
    </inertial>
  </link>
  <link name="wheel_link">
    <visual><geometry><cylinder radius="0.05" length="0.03"/></geometry></visual>
    <collision><geometry><cylinder radius="0.05" length="0.03"/></geometry></collision>
    <inertial>
      <mass value="0.4"/>
      <!-- Solid cylinder along link z (the joint axis): ixx = iyy = m(3r^2+h^2)/12, izz = m r^2/2 -->
      <inertia ixx="0.00028" ixy="0" ixz="0" iyy="0.00028" iyz="0" izz="0.00050"/>
    </inertial>
  </link>
  <joint name="wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_link"/>
    <origin xyz="0 0.16 0" rpy="1.5707963 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="5" velocity="20"/>
  </joint>
</robot>
