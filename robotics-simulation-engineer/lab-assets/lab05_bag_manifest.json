{
  "description": "Lab 05 recording contract for the shipped turtlebot_tutorial.usd scene. Replace the camera topics with the names your stage publishes.",
  "required_topics": {
    "/clock": "rosgraph_msgs/msg/Clock",
    "/joint_states": "sensor_msgs/msg/JointState",
    "/tf": "tf2_msgs/msg/TFMessage",
    "/odom": "nav_msgs/msg/Odometry",
    "/cmd_vel_raw": "geometry_msgs/msg/Twist",
    "/cmd_vel": "geometry_msgs/msg/Twist",
    "/camera_1/rgb/image_raw": "sensor_msgs/msg/Image",
    "/camera_1/rgb/camera_info": "sensor_msgs/msg/CameraInfo"
  },
  "required_tf_edges": [["odom", "base_link"]],
  "watchdog": {"raw": "/cmd_vel_raw", "safe": "/cmd_vel", "timeout_s": 0.5, "rate_hz": 20, "slack_s": 0.05},
  "image": {"topic": "/camera_1/rgb/image_raw", "camera_info": "/camera_1/rgb/camera_info"}
}
